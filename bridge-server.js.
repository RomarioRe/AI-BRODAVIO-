
const CONFIG = {
  version: "0.2",
  maxContentLength: 500000,
  allowedFiles: [
    "index.html",
    "README.md",
    "bridge.js",
    "bridge-server.js"
  ]
};

export default {
  async fetch(request, env) {
    const url = new URL(request.url);

    if (request.method === "GET" && url.pathname === "/health") {
      return json({
        project: "AI BRODAVIO",
        version: CONFIG.version,
        status: "online"
      });
    }

    if (request.method !== "POST" || url.pathname !== "/files") {
      return json({ error: "Not found" }, 404);
    }

    const auth = request.headers.get("Authorization");
    if (!env.BRIDGE_SECRET || auth !== `Bearer ${env.BRIDGE_SECRET}`) {
      return json({ error: "Unauthorized" }, 401);
    }

    if (!env.GITHUB_TOKEN || !env.GITHUB_OWNER || !env.GITHUB_REPO) {
      return json({ error: "Server configuration missing" }, 500);
    }

    let body;
    try {
      body = await request.json();
    } catch {
      return json({ error: "Invalid JSON" }, 400);
    }

    const { path, content, message } = body || {};

    if (
      typeof path !== "string" ||
      !CONFIG.allowedFiles.includes(path) ||
      typeof content !== "string" ||
      content.length > CONFIG.maxContentLength
    ) {
      return json({ error: "Invalid file or content" }, 400);
    }

    const apiUrl =
      `https://api.github.com/repos/${env.GITHUB_OWNER}/${env.GITHUB_REPO}/contents/${path}`;

    const headers = {
      "Authorization": `Bearer ${env.GITHUB_TOKEN}`,
      "Accept": "application/vnd.github+json",
      "X-GitHub-Api-Version": "2022-11-28",
      "Content-Type": "application/json"
    };

    let sha;

    const current = await fetch(apiUrl, { headers });

    if (current.ok) {
      const file = await current.json();
      sha = file.sha;
    } else if (current.status !== 404) {
      return json({ error: "GitHub read failed" }, 502);
    }

    const result = await fetch(apiUrl, {
      method: "PUT",
      headers,
      body: JSON.stringify({
        message: message || `Update ${path} via AI BRODAVIO`,
        content: btoa(unescape(encodeURIComponent(content))),
        ...(sha ? { sha } : {}),
        branch: "main"
      })
    });

    const data = await result.json();

    if (!result.ok) {
      return json({
        error: "GitHub write failed",
        status: result.status
      }, 502);
    }

    return json({
      success: true,
      file: path,
      commit: data.commit?.sha || null
    });
  }
};

function json(data, status = 200) {
  return new Response(JSON.stringify(data), {
    status,
    headers: { "Content-Type": "application/json" }
  });
}
